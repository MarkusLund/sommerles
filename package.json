{
  "name": "sommerles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n worker,client -c green,cyan \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:create": "wrangler d1 create sommerles",
    "db:local": "wrangler d1 execute sommerles --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute sommerles --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11",
    "wrangler": "^4.96.0"
  },
  "packageManager": "pnpm@9.1.0+sha1.217063ce3fcbf44f3051666f38b810f1ddefee4a"
}
